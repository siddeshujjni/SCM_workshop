# MAGIC     AND region_value IN (
# MAGIC       SELECT region FROM enbridge_scm.user_bu_mapping 
# MAGIC       WHERE user_email = current_user()
# MAGIC     )
# MAGIC   );
# MAGIC
# MAGIC -- Apply the row filter to the Gold table
# MAGIC ALTER TABLE gold_regional_supplier_coverage
# MAGIC SET ROW FILTER enbridge_scm.filter_by_user_bu(region);
# MAGIC */
